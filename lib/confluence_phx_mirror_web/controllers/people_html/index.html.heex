<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_source={@mirror_source}
  page_title={@page_title}
  sidebar?={false}
>
  <header class="border-b border-base-300/70 pb-5">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">Directory</p>
    <h1 class="mt-1 text-3xl font-semibold leading-tight">People</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-base-content/65">
      Authors of mirrored content. The mirror lists the bylines it synced from Confluence; it does
      not keep a separate user directory.
    </p>
  </header>

  <p :if={@authors == []} class="mt-8 text-sm text-base-content/50">No authors yet.</p>

  <ul :if={@authors != []} class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <li :for={author <- @authors}>
      <.link
        navigate={author_path(author)}
        class="group flex items-center gap-3 rounded-xl border border-base-300/70 bg-base-100 p-4 transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
      >
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary/10 text-sm font-semibold text-primary">
          {initials(author.name)}
        </span>
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold group-hover:text-primary">
            {author.name}
          </span>
          <span class="block text-[11px] text-base-content/45">
            {author.pages} {if author.pages == 1, do: "item", else: "items"} · updated {Time.ago(
              author.updated_at
            )}
          </span>
        </span>
      </.link>
    </li>
  </ul>
</Layouts.app>
