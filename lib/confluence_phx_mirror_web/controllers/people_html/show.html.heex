<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  live={@conn}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_url={@mirror_url}
  mirror_host={@mirror_host}
  mirror_source={@mirror_source}
  breadcrumbs={[%{title: "People", path: URLs.people_path()}]}
  page_title={@page_title}
  sidebar?={false}
>
  <header class="flex flex-wrap items-center gap-4 border-b border-base-300/70 pb-5">
    <img
      :if={@person && @person.avatar_blob_key}
      src={~p"/people/#{@author.account_id}/avatar"}
      alt=""
      width="56"
      height="56"
      class="size-14 shrink-0 rounded-full object-cover"
    />
    <span
      :if={is_nil(@person) or is_nil(@person.avatar_blob_key)}
      class="grid size-14 place-items-center rounded-full bg-primary/10 text-lg font-semibold text-primary"
    >
      {initials(@author.name)}
    </span>
    <div>
      <h1 class="text-2xl font-semibold leading-tight">{@author.name}</h1>
      <p :if={@author.pages > 0} class="mt-1 text-xs text-base-content/70">
        {@author.pages} {if @author.pages == 1, do: "item", else: "items"} · last change {Time.ago(
          @author.updated_at
        )}
      </p>
      <p :if={@author.pages == 0} class="mt-1 text-xs text-base-content/70">
        Nothing authored here yet — this identity is one the site's groups name.
      </p>
    </div>
  </header>

  <section class="mt-6">
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-base-content/70">
      Authored content
    </h2>
    <.page_list pages={@pages} empty="Nothing authored by this person." />

    <.page_nav
      :if={@pages != []}
      path={~p"/people/#{@author.account_id}"}
      offset={@offset}
      count={length(@pages)}
      per_page={25}
      more?={@more?}
    />
  </section>
</Layouts.app>
