<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  live={@conn}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_url={@mirror_url}
  mirror_host={@mirror_host}
  mirror_source={@mirror_source}
  page_title={@page_title}
  sidebar?={false}
>
  <header class="border-b border-base-300/70 pb-4">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">MCP</p>
    <h1 class="mt-1 text-3xl font-semibold">Let an assistant read this mirror</h1>
    <p class="mt-2 max-w-3xl text-sm text-base-content/70">
      Every way in is read-only. No tool call here can change content: pages arrive
      by syncing from Confluence, and nowhere else.
    </p>
  </header>

  <div class="mt-6 grid gap-4">
    <.option
      number="1"
      title="This mirror's own MCP server"
      summary="Nothing to install, nothing to run: the server is this app."
    >
      <p class="text-sm text-base-content/70">
        One endpoint, Streamable HTTP, authenticated the way the rest of the mirror
        is: the client opens a browser and authorizes itself, or presents a personal
        API token. Tools cover search, the space tree, pages as Markdown, and
        discussion.
      </p>
      <pre
        phx-no-curly-interpolation
        class="mt-3 overflow-x-auto rounded-lg bg-base-200/60 p-3 text-xs"
      ><code><%= @mcp_url %></code></pre>
    </.option>

    <.option
      number="2"
      title="sooperset's mcp-atlassian, pointed at this mirror"
      summary="A third-party MCP server that speaks Confluence. This mirror answers the same API, so it works unchanged."
    >
      <p class="text-sm text-base-content/70">
        Run the server from its own package with the same settings a real Confluence
        would take, with this mirror as the site. Searching and reading work; the
        tools that create, update or comment fail, because the mirror answers reads
        and nothing else.
      </p>
      <pre
        phx-no-curly-interpolation
        class="mt-3 overflow-x-auto rounded-lg bg-base-200/60 p-3 text-xs"
      ><code>CONFLUENCE_URL=<%= @confluence_url %> \
CONFLUENCE_USERNAME=<i>your account here</i> \
CONFLUENCE_API_TOKEN=<i>a personal API token from this mirror</i> \
uvx mcp-atlassian</code></pre>
      <p class="mt-2 text-xs text-base-content/60">
        Confluence Server and Data Center users give a personal access token instead,
        as CONFLUENCE_PERSONAL_TOKEN, and no user name. The project's own documentation
        at github.com/sooperset/mcp-atlassian has the Docker image and the HTTP
        transports.
      </p>
    </.option>

    <.option
      number="3"
      title="One file for VS Code"
      summary=".vscode/mcp.json starts either server; both blocks are below."
    >
      <pre
        phx-no-curly-interpolation
        class="mt-1 overflow-x-auto rounded-lg bg-base-200/60 p-3 text-xs"
      ><code>{
  "servers": {
    "confluence-mirror": {
      "type": "http",
      "url": "<%= @mcp_url %>"
    },
    "confluence-mirror-atlassian": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "CONFLUENCE_URL": "<%= @confluence_url %>",
        "CONFLUENCE_USERNAME": "your account here",
        "CONFLUENCE_API_TOKEN": "a personal API token from this mirror"
      }
    }
  }
}</code></pre>
      <p class="mt-2 text-xs text-base-content/60">
        Start one or the other, not both: each keeps its own connection and its own
        rate limiter, and a mirror answers one reader either way.
      </p>
    </.option>
  </div>

  <section class="mt-8 border-t border-base-300/70 pt-4">
    <h2 class="text-sm font-semibold">What an assistant can ask for</h2>
    <ul class="mt-2 grid gap-1 text-sm text-base-content/70 sm:grid-cols-2">
      <li class="flex items-start gap-2">
        <.icon name="hero-magnifying-glass" class="mt-0.5 size-4 shrink-0" />
        Search by words, and by Confluence's own query language
      </li>
      <li class="flex items-start gap-2">
        <.icon name="hero-folder-open" class="mt-0.5 size-4 shrink-0" />
        The space tree, and the pages in a space
      </li>
      <li class="flex items-start gap-2">
        <.icon name="hero-document-text" class="mt-0.5 size-4 shrink-0" />
        One page as Markdown, whole, with its links rewritten
      </li>
      <li class="flex items-start gap-2">
        <.icon name="hero-chat-bubble-left-right" class="mt-0.5 size-4 shrink-0" />
        The discussion attached to a page, where the mirror has it
      </li>
    </ul>
  </section>
</Layouts.app>
