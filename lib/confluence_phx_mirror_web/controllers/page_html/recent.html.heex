<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  live={@conn}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_url={@mirror_url}
  mirror_host={@mirror_host}
  mirror_source={@mirror_source}
  page_title={@page_title}
  sidebar?={false}
>
  <header class="border-b border-base-300/70 pb-5">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">Activity</p>
    <h1 class="mt-1 text-3xl font-semibold leading-tight">Recently updated</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-base-content/70">
      What the mirror pulled most recently, newest first — the page, the space it
      lives in, who wrote it, and when Confluence last changed it.
    </p>
  </header>

  <.empty_state
    :if={@pages == []}
    icon="hero-clock"
    title="Nothing mirrored yet"
    body="Once a sync has pulled content, the newest pages appear here."
  />

  <%!-- A feed of changes is one fact per row: a card per page, with its own border
  and padding, fitted seven changes on a screen and left a hand's width of empty
  space between the title and the timestamp. A table puts that width to work as
  the space and the author, and the whole row is the link, so the target is the
  width of the page. --%>
  <div :if={@pages != []} class="mt-6 overflow-hidden rounded-xl border border-base-300/70">
    <table id="recent-pages" class="w-full table-fixed text-sm">
      <caption class="sr-only">
        Pages the mirror pulled most recently, newest first
      </caption>
      <thead>
        <tr class="border-b border-base-300/70 bg-base-200/40 text-[11px] uppercase tracking-[0.08em] text-base-content/60">
          <th scope="col" class="py-2 pl-3 pr-2 text-left font-semibold">Page</th>
          <th scope="col" class="hidden w-48 px-2 py-2 text-left font-semibold md:table-cell">
            Space
          </th>
          <th scope="col" class="hidden w-44 px-2 py-2 text-left font-semibold lg:table-cell">
            Author
          </th>
          <th scope="col" class="w-32 py-2 pl-2 pr-3 text-right font-semibold">
            Updated <span aria-hidden="true">↓</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-base-300/60 bg-base-100">
        <tr
          :for={page <- @pages}
          id={"recent-page-#{page.id}"}
          class="group relative transition hover:bg-base-200/50 focus-within:bg-base-200/50"
        >
          <td class="py-2 pl-3 pr-2">
            <span class="flex min-w-0 items-center gap-2">
              <.icon
                name={
                  if page.type == "blogpost", do: "hero-newspaper", else: "hero-document-text"
                }
                class="size-3.5 shrink-0 text-base-content/50"
              />
              <%!-- The overlay makes the whole row clickable without nesting links;
              the anchor keeps the title's text for the keyboard and for copying. --%>
              <.link
                navigate={ConfluencePhxMirror.Mirror.URLs.content_path(page.space.key, page)}
                class="min-w-0 max-w-[36ch] truncate font-medium after:absolute after:inset-0 after:content-[''] group-hover:text-primary focus-visible:outline-none"
              >
                {page.title}
              </.link>
              <span
                :if={change_kind(page) == "created"}
                data-change="created"
                class="shrink-0 text-[10px] font-semibold uppercase tracking-[0.08em] text-primary"
                title="Confluence has no earlier version of this page"
              >
                new
              </span>
              <%!-- The width a table row has to spare goes to the page's own words:
              a title alone says what a page is called, not what changed on it. --%>
              <span class="hidden min-w-0 flex-1 truncate text-xs text-base-content/45 md:block">
                {excerpt(page.body_text)}
              </span>
            </span>
          </td>
          <td class="hidden px-2 py-2 text-xs text-base-content/70 md:table-cell">
            <span class="block truncate" title={page.space.name}>{page.space.name}</span>
          </td>
          <td class="hidden px-2 py-2 text-xs text-base-content/70 lg:table-cell">
            <span class="block truncate">{page.author_name || "unknown author"}</span>
          </td>
          <td class="py-2 pl-2 pr-3 text-right text-xs text-base-content/70">
            <.local_time at={page.external_updated_at} class="whitespace-nowrap">
              {ConfluencePhxMirrorWeb.Time.ago(page.external_updated_at)}
            </.local_time>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <.page_nav
    :if={@pages != []}
    path={~p"/recent"}
    offset={@offset}
    count={length(@pages)}
    per_page={25}
    more?={@more?}
  />
</Layouts.app>
