<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_source={@mirror_source}
  page_title={@page_title}
  sidebar?={false}
>
  <header class="border-b border-base-300/70 pb-5">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">Activity</p>
    <h1 class="mt-1 text-3xl font-semibold leading-tight">Recently updated</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-base-content/65">
      The newest content the mirror has pulled, across all spaces.
    </p>
  </header>

  <.empty_state
    :if={@pages == []}
    icon="hero-clock"
    title="Nothing mirrored yet"
    body="Once a sync has pulled content, the newest pages appear here."
  />

  <ul class="mt-6 space-y-2">
    <li :for={page <- @pages}>
      <.link
        navigate={ConfluencePhxMirror.Mirror.URLs.content_path(page.space.key, page)}
        class="group flex items-start justify-between gap-4 rounded-xl border border-base-300/70 bg-base-100 p-4 transition hover:border-primary/40 hover:shadow-sm"
      >
        <span class="min-w-0">
          <span class="flex items-center gap-2 text-sm font-semibold group-hover:text-primary">
            <.icon
              name={if page.type == "blogpost", do: "hero-newspaper", else: "hero-document-text"}
              class="size-4 shrink-0 text-base-content/70"
            />
            <span class="truncate">{page.title}</span>
          </span>
          <span class="mt-1 block truncate text-xs text-base-content/70">
            {page.space.name} · {page.author_name}
          </span>
        </span>
        <span class="whitespace-nowrap text-[11px] uppercase tracking-wide text-base-content/70">
          {ConfluencePhxMirrorWeb.Time.ago(page.external_updated_at)}
        </span>
      </.link>
    </li>
  </ul>

  <.page_nav
    :if={@pages != []}
    path={~p"/recent"}
    offset={@offset}
    count={length(@pages)}
    per_page={25}
    more?={@more?}
  />
</Layouts.app>
