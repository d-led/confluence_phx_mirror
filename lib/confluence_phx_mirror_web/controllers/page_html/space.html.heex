<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_source={@mirror_source}
  space={@space}
  tree={@tree}
  breadcrumbs={@breadcrumbs}
  page_title={@page_title}
  rail?={false}
>
  <header class="border-b border-base-300/70 pb-5">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">Space</p>
    <div class="mt-1 flex flex-wrap items-center gap-2">
      <h1 class="text-3xl font-semibold leading-tight">{@space.name}</h1>
      <span class="badge badge-ghost badge-sm">{@space.key}</span>
    </div>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-base-content/65">
      {@space.description || "No description in Confluence."}
    </p>
    <p :if={@space.synced_at} class="mt-2 text-xs text-base-content/50">
      Space metadata synced {Time.ago(@space.synced_at)}.
    </p>
  </header>

  <section class="mt-8">
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-base-content/50">
      Top-level pages
    </h2>
    <p :if={@root_pages == []} class="text-sm text-base-content/50">
      This space has no pages yet.
    </p>
    <ul :if={@root_pages != []} class="grid gap-3 sm:grid-cols-2">
      <li :for={page <- @root_pages}>
        <.link
          navigate={
            ConfluencePhxMirror.Mirror.URLs.page_path(@space.key, page.confluence_id, page.slug)
          }
          class="group flex h-full flex-col rounded-xl border border-base-300/70 bg-base-100 p-4 transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
        >
          <span class="flex items-center gap-2 text-sm font-semibold group-hover:text-primary">
            <.icon name="hero-document-text" class="size-4 text-base-content/40" />
            <span class="truncate">{page.title}</span>
          </span>
          <span class="mt-1 line-clamp-2 text-xs text-base-content/55">
            {String.slice(page.body_text || "", 0, 180)}
          </span>
          <span class="mt-3 text-[10px] uppercase tracking-wide text-base-content/35">
            Updated {Time.ago(page.external_updated_at)}
          </span>
        </.link>
      </li>
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-base-content/50">
      Recently updated
    </h2>
    <.page_list pages={@recent_pages} empty="Nothing yet." />
  </section>
</Layouts.app>
