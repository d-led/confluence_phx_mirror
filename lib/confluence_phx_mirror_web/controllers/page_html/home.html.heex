<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  spaces={@spaces |> Enum.map(&elem(&1, 0))}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_source={@mirror_source}
  page_title={@page_title}
  sidebar?={false}
>
  <section class="overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-br from-primary/10 via-base-100 to-secondary/10 p-6 sm:p-10">
    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary">
      {@mirror_name}
    </p>
    <h1 class="mt-2 max-w-2xl text-balance text-3xl font-semibold leading-tight sm:text-4xl">
      A fast, read-only mirror of Confluence — searchable, linkable, always available.
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-base-content/65">
      Every page keeps Confluence's own macro rendering, cross-links are rewritten
      to stay inside the mirror, attachments are served locally, and search runs on
      Postgres full-text indexes across titles, bodies, labels, authors and
      attachment names.
    </p>

    <form action={~p"/search"} method="get" class="mt-6 flex max-w-2xl flex-col gap-2 sm:flex-row">
      <label class="input flex flex-1 items-center gap-2 rounded-lg border-base-300 bg-base-100">
        <.icon name="hero-magnifying-glass" class="size-4 opacity-50" />
        <input
          type="search"
          name="q"
          aria-label="Search the mirror"
          class="grow bg-transparent outline-none placeholder:text-base-content/40"
          placeholder="Search pages, decisions, people…"
          autofocus
        />
      </label>
      <button type="submit" class="btn btn-primary">Search mirror</button>
    </form>

    <div class="mt-3 flex flex-wrap items-center gap-1.5 text-[11px] text-base-content/50">
      <span>Examples:</span>
      <a href="/search?q=architecture" class="badge badge-ghost badge-sm">architecture</a>
      <a href="/search?q=rate+limit" class="badge badge-ghost badge-sm">rate limit</a>
      <a href="/search?q=%22rate+limit%22+NOT+roadmap" class="badge badge-ghost badge-sm">
        "rate limit" NOT roadmap
      </a>
      <a href="/search?type=blogpost" class="badge badge-ghost badge-sm">blog posts</a>
    </div>
  </section>

  <section class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-xl border border-base-300/70 bg-base-100 p-4">
      <p class="text-[11px] uppercase tracking-wider text-base-content/45">Spaces</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums">{@stats.spaces}</p>
    </div>
    <div class="rounded-xl border border-base-300/70 bg-base-100 p-4">
      <p class="text-[11px] uppercase tracking-wider text-base-content/45">Pages</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums">{@stats.pages}</p>
    </div>
    <div class="rounded-xl border border-base-300/70 bg-base-100 p-4">
      <p class="text-[11px] uppercase tracking-wider text-base-content/45">Attachments</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums">{@stats.attachments}</p>
    </div>
    <div class="rounded-xl border border-base-300/70 bg-base-100 p-4">
      <p class="text-[11px] uppercase tracking-wider text-base-content/45">Last sync</p>
      <p class="mt-1 truncate text-sm font-semibold">
        {if @last_sync_run,
          do: Time.ago(@last_sync_run.finished_at || @last_sync_run.started_at),
          else: "never"}
      </p>
    </div>
  </section>

  <section class="mt-10">
    <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/50">Spaces</h2>
      <div class="flex flex-wrap gap-3 text-xs font-medium text-primary">
        <a href={~p"/spaces"} class="hover:underline">All spaces →</a>
        <a href={~p"/labels"} class="hover:underline">Labels →</a>
        <a href={~p"/people"} class="hover:underline">People →</a>
        <a href={~p"/recent"} class="hover:underline">Recently updated →</a>
      </div>
    </div>
    <.empty_state
      :if={@spaces == []}
      icon="hero-arrow-path"
      title="Nothing mirrored yet"
      body="Run `mix confluence.sync` or open the admin dashboard and press “Sync now”."
    />
    <div :if={@spaces != []} class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <.space_card :for={{space, count} <- @spaces} space={space} count={count} />
    </div>
  </section>

  <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_20rem]">
    <section>
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-base-content/50">
        Recently updated
      </h2>
      <p :if={@recent_pages == []} class="text-xs text-base-content/50">No pages yet.</p>
      <ul
        :if={@recent_pages != []}
        class="divide-y divide-base-300/60 overflow-hidden rounded-xl border border-base-300/70 bg-base-100"
      >
        <li :for={page <- @recent_pages}>
          <.link
            navigate={ConfluencePhxMirror.Mirror.URLs.content_path(page.space.key, page)}
            class="group flex items-center gap-3 px-4 py-3 transition hover:bg-base-200/40"
          >
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-base-200 text-base-content/50">
              <.icon
                name={
                  if page.type == "blogpost", do: "hero-newspaper", else: "hero-document-text"
                }
                class="size-4"
              />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium group-hover:text-primary">
                {page.title}
              </span>
              <span class="block text-[11px] text-base-content/45">
                {page.space.name} · {Time.ago(page.external_updated_at)}
              </span>
            </span>
            <span class="hidden shrink-0 text-[10px] text-base-content/40 sm:block">
              {page.space.key}
            </span>
          </.link>
        </li>
      </ul>
    </section>

    <aside class="space-y-5">
      <.rail_section title="Freshness" icon="hero-arrow-path">
        <div :if={@last_sync_run} class="space-y-1">
          <p class="text-sm font-medium">
            {Time.ago(@last_sync_run.finished_at || @last_sync_run.started_at)}
          </p>
          <p class="text-xs text-base-content/55">
            {String.capitalize(@last_sync_run.mode)} sync · {@last_sync_run.status} · {@last_sync_run.stats[
              "pages"
            ] || 0} pages
          </p>
          <p class="text-[11px] text-base-content/40">
            {Time.datetime(@last_sync_run.finished_at)}
          </p>
        </div>
        <p :if={is_nil(@last_sync_run)} class="text-xs text-base-content/50">No sync yet.</p>
      </.rail_section>

      <.rail_section :if={@last_webhook} title="Last webhook" icon="hero-bolt">
        <p class="text-xs font-medium">{@last_webhook.event_type || "unknown event"}</p>
        <p class="mt-0.5 text-[11px] text-base-content/50">
          {@last_webhook.status} · {Time.ago(@last_webhook.received_at)}
        </p>
      </.rail_section>

      <.rail_section title="Labels" icon="hero-tag">
        <div class="flex flex-wrap gap-1.5">
          <a
            :for={{label, _count} <- Enum.take(@labels, 14)}
            href={~p"/labels/#{label}"}
            class="badge badge-outline badge-sm border-base-300 normal-case hover:border-primary hover:text-primary"
          >
            {label}
          </a>
        </div>
        <p :if={@labels == []} class="text-xs text-base-content/50">No labels yet.</p>
      </.rail_section>
    </aside>
  </div>
</Layouts.app>
