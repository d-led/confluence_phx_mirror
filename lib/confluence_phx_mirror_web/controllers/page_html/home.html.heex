<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  spaces={@spaces |> Enum.map(&elem(&1, 0))}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_url={@mirror_url}
  mirror_host={@mirror_host}
  mirror_source={@mirror_source}
  page_title={@page_title}
  sidebar?={false}
  search?={false}
>
  <section class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-base-300/70 pb-4">
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold tracking-tight">{@mirror_name}</h1>
      <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-base-content/70">
        <a
          :if={@mirror_url}
          href={@mirror_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
        >
          <.icon name="hero-arrow-top-right-on-square" class="size-3.5" /> {@mirror_host}
        </a>
        <span class="text-base-content/70">·</span>
        <span>
          {@stats.spaces} spaces · {@stats.pages} pages · {@stats.attachments} attachments
          · synced {if @last_sync_run,
            do: Time.ago(@last_sync_run.finished_at || @last_sync_run.started_at),
            else: "never"}
        </span>
      </p>
    </div>

    <form action={~p"/search"} method="get" class="flex w-full max-w-md gap-2">
      <label class="input input-sm flex flex-1 items-center gap-2 rounded-lg border-base-300 bg-base-200/50">
        <.icon name="hero-magnifying-glass" class="size-4 opacity-50" />
        <input
          type="search"
          name="q"
          aria-label="Search the mirror"
          class="grow bg-transparent outline-none placeholder:text-base-content/70"
          placeholder="Search pages, decisions, people…"
        />
      </label>
      <button type="submit" class="btn btn-primary btn-sm">Search</button>
    </form>
  </section>

  <section class="mt-6">
    <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/70">Spaces</h2>
      <div class="flex flex-wrap gap-3 text-xs font-medium text-primary">
        <a href={~p"/spaces"} class="hover:underline">All spaces →</a>
        <a href={~p"/labels"} class="hover:underline">Labels →</a>
        <a href={~p"/people"} class="hover:underline">People →</a>
        <a href={~p"/recent"} class="hover:underline">Recently updated →</a>
      </div>
    </div>
    <.empty_state
      :if={@spaces == []}
      icon="hero-arrow-path"
      title="Nothing mirrored yet"
      body="No content has been copied from Confluence so far. The About page explains what this mirror is and who runs it."
    />
    <ul
      :if={@spaces != []}
      class="divide-y divide-base-300/60 overflow-hidden rounded-xl border border-base-300/70 bg-base-100"
    >
      <li :for={{space, count} <- @spaces}>
        <.space_card space={space} count={count} />
      </li>
    </ul>
    <p :if={@space_total > length(@spaces)} class="mt-3 text-xs text-base-content/70">
      Showing {length(@spaces)} of {@space_total} spaces.
      <a href={~p"/spaces"} class="font-medium text-primary hover:underline">
        All spaces →
      </a>
    </p>
  </section>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_20rem]">
    <section>
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-base-content/70">
        Recently updated
      </h2>
      <p :if={@recent_pages == []} class="text-xs text-base-content/70">No pages yet.</p>
      <ul
        :if={@recent_pages != []}
        class="divide-y divide-base-300/60 overflow-hidden rounded-xl border border-base-300/70 bg-base-100"
      >
        <li :for={page <- @recent_pages}>
          <.link
            navigate={ConfluencePhxMirror.Mirror.URLs.content_path(page.space.key, page)}
            class="group flex items-center gap-3 px-4 py-3 transition hover:bg-base-200/40"
          >
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-base-200 text-base-content/70">
              <.icon
                name={
                  if page.type == "blogpost", do: "hero-newspaper", else: "hero-document-text"
                }
                class="size-4"
              />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium group-hover:text-primary">
                {page.title}
              </span>
              <span class="block text-[11px] text-base-content/70">
                {page.space.name} · {Time.ago(page.external_updated_at)}
              </span>
            </span>
            <span class="hidden shrink-0 text-[10px] text-base-content/70 sm:block">
              {page.space.key}
            </span>
          </.link>
        </li>
      </ul>
    </section>

    <aside class="space-y-5">
      <.rail_section title="Freshness" icon="hero-arrow-path">
        <div :if={@last_sync_run} class="space-y-1">
          <p class="text-sm font-medium">
            {Time.ago(@last_sync_run.finished_at || @last_sync_run.started_at)}
          </p>
          <p class="text-xs text-base-content/70">
            {String.capitalize(@last_sync_run.mode)} sync · {@last_sync_run.status} · {@last_sync_run.stats[
              "pages"
            ] || 0} pages
          </p>
          <p class="text-[11px] text-base-content/70">
            <.local_time at={@last_sync_run.finished_at} />
          </p>
        </div>
        <p :if={is_nil(@last_sync_run)} class="text-xs text-base-content/70">No sync yet.</p>
      </.rail_section>

      <.rail_section :if={@last_webhook} title="Last webhook" icon="hero-bolt">
        <p class="text-xs font-medium">{@last_webhook.event_type || "unknown event"}</p>
        <p class="mt-0.5 text-[11px] text-base-content/70">
          {@last_webhook.status} · {Time.ago(@last_webhook.received_at)}
        </p>
      </.rail_section>

      <.rail_section title="Labels" icon="hero-tag">
        <div class="flex flex-wrap gap-1.5">
          <a
            :for={%{name: label} <- @labels}
            href={~p"/labels/#{label}"}
            class="badge badge-outline badge-sm border-base-300 normal-case hover:border-primary hover:text-primary"
          >
            {label}
          </a>
        </div>
        <p :if={@labels == []} class="text-xs text-base-content/70">No labels yet.</p>
      </.rail_section>
    </aside>
  </div>
</Layouts.app>
