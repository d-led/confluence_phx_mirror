<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  live={@conn}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_url={@mirror_url}
  mirror_host={@mirror_host}
  mirror_source={@mirror_source}
  space={@space}
  tree={@tree}
  breadcrumbs={[%{title: @space.name, path: URLs.space_path(@space.key)}]}
  page_title={@page_title}
  rail?={false}
>
  <header class="border-b border-base-300/70 pb-5">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">Space</p>
    <div class="mt-1 flex flex-wrap items-center gap-2">
      <img
        :if={@space.icon_blob_key}
        src={~p"/spaces/#{@space.key}/icon"}
        alt=""
        width="40"
        height="40"
        class="size-10 shrink-0 rounded-lg object-cover"
      />
      <h1 class="text-3xl font-semibold leading-tight">{@space.name}</h1>
      <span class="badge badge-ghost badge-sm">{@space.key}</span>
      <span :for={label <- @space.labels} class="badge badge-outline badge-sm">{label}</span>
    </div>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-base-content/70">
      {@space.description || "No description in Confluence."}
    </p>
    <p :if={@space.synced_at} class="mt-2 text-xs text-base-content/70">
      Space metadata synced {Time.ago(@space.synced_at)}.
    </p>
  </header>

  <div class="mt-4 border-b border-base-300/70">
    <.space_tabs space={@space} active={@active} />
  </div>

  <div class="mt-6 grid gap-8 lg:grid-cols-3">
    <div class="space-y-8 lg:col-span-2">
      <section :if={@home}>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-base-content/70">
          Space home
        </h2>
        <.link
          navigate={URLs.content_path(@space.key, @home)}
          class="group block rounded-xl border border-base-300/70 bg-base-100 p-5 transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
        >
          <span class="text-base font-semibold group-hover:text-primary">{@home.title}</span>
          <span class="mt-2 block line-clamp-3 text-sm leading-relaxed text-base-content/70">
            {String.slice(@home.body_text || "", 0, 400)}
          </span>
          <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-primary">
            Read the home page <.icon name="hero-arrow-right" class="size-3.5" />
          </span>
        </.link>
      </section>

      <section>
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/70">
            Top-level pages
          </h2>
          <.link navigate={~p"/spaces/#{@space.key}/pages"} class="link link-primary text-xs">
            All pages →
          </.link>
        </div>
        <p :if={@root_pages == []} class="text-sm text-base-content/70">
          This space has no pages yet.
        </p>
        <ul
          :if={@root_pages != []}
          class="divide-y divide-base-300/60 overflow-hidden rounded-xl border border-base-300/70 bg-base-100"
        >
          <li :for={page <- @root_pages}>
            <.link
              navigate={URLs.content_path(@space.key, page)}
              class="group flex min-h-14 items-center gap-3 px-4 py-3 transition hover:bg-base-200/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-inset"
            >
              <.icon
                name={
                  if page.type == "blogpost", do: "hero-newspaper", else: "hero-document-text"
                }
                class="size-4 shrink-0 text-base-content/70"
              />
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold group-hover:text-primary">
                  {page.title}
                </span>
                <span class="mt-0.5 block truncate text-xs text-base-content/70">
                  {String.slice(page.body_text || "No text.", 0, 120)}
                </span>
              </span>
              <span class="shrink-0 text-[11px] text-base-content/70">
                {Time.ago(page.external_updated_at)}
              </span>
            </.link>
          </li>
        </ul>
      </section>

      <section>
        <div class="mb-3 flex items-baseline justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/70">
            Recently updated
          </h2>
          <.link
            navigate={URLs.space_pages_path(@space.key)}
            class="text-xs text-primary hover:underline"
          >
            All pages →
          </.link>
        </div>
        <.page_list pages={@recent_pages} space_key={@space.key} empty="Nothing yet." />
      </section>
    </div>

    <aside class="space-y-6">
      <section class="rounded-xl border border-base-300/70 bg-base-100 p-4">
        <div class="mb-2 flex items-baseline justify-between">
          <h2 class="text-sm font-semibold">Blog</h2>
          <.link
            navigate={URLs.space_blog_path(@space.key)}
            class="text-xs text-primary hover:underline"
          >
            All posts →
          </.link>
        </div>
        <p :if={@posts == []} class="text-xs text-base-content/70">
          No blog posts in this space.
        </p>
        <ul :if={@posts != []} class="space-y-2">
          <li :for={post <- @posts}>
            <.link
              navigate={URLs.content_path(@space.key, post)}
              class="group block text-sm font-medium hover:text-primary"
            >
              {post.title}
              <span class="mt-0.5 block text-[11px] text-base-content/70">
                <.local_time at={post.external_updated_at} format={:date} /> · {post.author_name}
              </span>
            </.link>
          </li>
        </ul>
      </section>

      <section class="rounded-xl border border-base-300/70 bg-base-100 p-4">
        <div class="mb-2 flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold">Labels</h2>
          <.link navigate={~p"/labels"} class="link link-primary text-xs">All labels →</.link>
        </div>
        <p :if={@labels == []} class="text-xs text-base-content/70">No labels in this space.</p>
        <ul :if={@labels != []} class="flex flex-wrap gap-1.5">
          <li :for={{name, count} <- @labels}>
            <.link
              navigate={URLs.label_path(name)}
              class="badge badge-ghost badge-sm gap-1 transition hover:border-primary/40 hover:text-primary"
            >
              {name} <span class="text-base-content/70">{count}</span>
            </.link>
          </li>
        </ul>
      </section>

      <section class="rounded-xl border border-base-300/70 bg-base-100 p-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold">Attachments</h2>
          <span class="text-xs tabular-nums text-base-content/70">{@attachment_count}</span>
        </div>
        <.link
          navigate={URLs.space_attachments_path(@space.key)}
          class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline"
        >
          Browse attachments <.icon name="hero-arrow-right" class="size-3.5" />
        </.link>
      </section>

      <%!-- Only an administrator is given @grants: who may read a space is the
      site's decision, and the mirror should be checkable against it. --%>
      <section
        :if={assigns[:grants]}
        id="space-access"
        class="rounded-xl border border-base-300/70 bg-base-100 p-4"
      >
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold">Who can read this space</h2>
          <span class="badge badge-ghost badge-xs">from the last sync</span>
        </div>

        <p
          :if={@grants.personal}
          id="space-access-personal"
          class="mt-2 text-[11px] text-base-content/70"
        >
          A personal space: only {@grants.personal} may read it, and an administrator. Its
          permissions do not have to say so — a personal space is narrowed by being somebody's.
        </p>

        <p
          :if={not @grants.synced? and is_nil(@grants.personal)}
          id="space-access-unknown"
          class="mt-2 text-[11px] text-base-content/70"
        >
          No permissions have been mirrored for this space, so nothing narrows it: every reader of
          the mirror can open it. Run a sync to read them from Confluence.
        </p>

        <div :if={@grants.synced?} class="mt-2 space-y-2 text-xs">
          <div :if={@grants.anonymous} id="space-access-anonymous">
            <span class="badge badge-warning badge-sm">anonymous readers</span>
          </div>

          <div :if={@grants.groups != []}>
            <p class="text-[11px] font-medium uppercase tracking-wider text-base-content/60">
              Groups
            </p>
            <div class="mt-1 flex flex-wrap gap-1">
              <span
                :for={group <- @grants.groups}
                id={"space-access-group-#{group}"}
                class="badge badge-ghost badge-sm"
              >
                {group}
              </span>
            </div>
          </div>

          <div :if={@grants.users != []}>
            <p class="text-[11px] font-medium uppercase tracking-wider text-base-content/60">
              People
            </p>
            <ul class="mt-1 space-y-1">
              <li :for={user <- @grants.users} class="truncate">
                {user.label}
                <span :if={not user.account?} class="text-[11px] text-base-content/60">
                  (no account here)
                </span>
              </li>
            </ul>
          </div>

          <p
            :if={not @grants.anonymous and @grants.groups == [] and @grants.users == []}
            class="text-[11px] text-base-content/70"
          >
            The site grants this space to no one the mirror can name — only administrators can see it.
          </p>
        </div>
      </section>

      <section class="rounded-xl border border-base-300/70 bg-base-100 p-4">
        <h2 class="text-sm font-semibold">Export</h2>
        <p class="mt-1 text-xs text-base-content/70">
          The whole space as Markdown with its attachments, as a ZIP.
        </p>
        <a
          href={~p"/spaces/#{@space.key}/export.zip"}
          class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline"
        >
          Download Markdown (.zip) <.icon name="hero-arrow-down-tray" class="size-3.5" />
        </a>
      </section>
    </aside>
  </div>
</Layouts.app>
