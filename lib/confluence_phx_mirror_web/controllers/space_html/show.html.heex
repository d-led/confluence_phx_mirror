<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_source={@mirror_source}
  space={@space}
  tree={@tree}
  breadcrumbs={[%{title: @space.name, path: URLs.space_path(@space.key)}]}
  page_title={@page_title}
  rail?={false}
>
  <header class="border-b border-base-300/70 pb-5">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">Space</p>
    <div class="mt-1 flex flex-wrap items-center gap-2">
      <h1 class="text-3xl font-semibold leading-tight">{@space.name}</h1>
      <span class="badge badge-ghost badge-sm">{@space.key}</span>
    </div>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-base-content/70">
      {@space.description || "No description in Confluence."}
    </p>
    <p :if={@space.synced_at} class="mt-2 text-xs text-base-content/70">
      Space metadata synced {Time.ago(@space.synced_at)}.
    </p>
  </header>

  <div class="mt-4 border-b border-base-300/70">
    <.space_tabs space={@space} active={@active} />
  </div>

  <div class="mt-6 grid gap-8 lg:grid-cols-3">
    <div class="space-y-8 lg:col-span-2">
      <section :if={@home}>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-base-content/70">
          Space home
        </h2>
        <.link
          navigate={URLs.content_path(@space.key, @home)}
          class="group block rounded-xl border border-base-300/70 bg-base-100 p-5 transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
        >
          <span class="text-base font-semibold group-hover:text-primary">{@home.title}</span>
          <span class="mt-2 block line-clamp-3 text-sm leading-relaxed text-base-content/70">
            {String.slice(@home.body_text || "", 0, 400)}
          </span>
          <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-primary">
            Read the home page <.icon name="hero-arrow-right" class="size-3.5" />
          </span>
        </.link>
      </section>

      <section>
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/70">
            Top-level pages
          </h2>
          <.link navigate={~p"/spaces/#{@space.key}/pages"} class="link link-primary text-xs">
            All pages →
          </.link>
        </div>
        <p :if={@root_pages == []} class="text-sm text-base-content/70">
          This space has no pages yet.
        </p>
        <ul :if={@root_pages != []} class="grid gap-3 sm:grid-cols-2">
          <li :for={page <- @root_pages}>
            <.link
              navigate={URLs.content_path(@space.key, page)}
              class="group flex h-full flex-col rounded-xl border border-base-300/70 bg-base-100 p-4 transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
            >
              <span class="flex items-center gap-2 text-sm font-semibold group-hover:text-primary">
                <.icon
                  name={
                    if page.type == "blogpost", do: "hero-newspaper", else: "hero-document-text"
                  }
                  class="size-4 text-base-content/70"
                />
                <span class="truncate">{page.title}</span>
              </span>
              <span class="mt-1 line-clamp-2 text-xs text-base-content/70">
                {String.slice(page.body_text || "", 0, 180)}
              </span>
              <span class="mt-3 text-[10px] uppercase tracking-wide text-base-content/70">
                Updated {Time.ago(page.external_updated_at)}
              </span>
            </.link>
          </li>
        </ul>
      </section>

      <section>
        <div class="mb-3 flex items-baseline justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/70">
            Recently updated
          </h2>
          <.link
            navigate={URLs.space_pages_path(@space.key)}
            class="text-xs text-primary hover:underline"
          >
            All pages →
          </.link>
        </div>
        <.page_list pages={@recent_pages} space_key={@space.key} empty="Nothing yet." />
      </section>
    </div>

    <aside class="space-y-6">
      <section class="rounded-xl border border-base-300/70 bg-base-100 p-4">
        <div class="mb-2 flex items-baseline justify-between">
          <h2 class="text-sm font-semibold">Blog</h2>
          <.link
            navigate={URLs.space_blog_path(@space.key)}
            class="text-xs text-primary hover:underline"
          >
            All posts →
          </.link>
        </div>
        <p :if={@posts == []} class="text-xs text-base-content/70">
          No blog posts in this space.
        </p>
        <ul :if={@posts != []} class="space-y-2">
          <li :for={post <- @posts}>
            <.link
              navigate={URLs.content_path(@space.key, post)}
              class="group block text-sm font-medium hover:text-primary"
            >
              {post.title}
              <span class="mt-0.5 block text-[11px] text-base-content/70">
                {Time.date(post.external_updated_at)} · {post.author_name}
              </span>
            </.link>
          </li>
        </ul>
      </section>

      <section class="rounded-xl border border-base-300/70 bg-base-100 p-4">
        <div class="mb-2 flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold">Labels</h2>
          <.link navigate={~p"/labels"} class="link link-primary text-xs">All labels →</.link>
        </div>
        <p :if={@labels == []} class="text-xs text-base-content/70">No labels in this space.</p>
        <ul :if={@labels != []} class="flex flex-wrap gap-1.5">
          <li :for={{name, count} <- @labels}>
            <.link
              navigate={URLs.label_path(name)}
              class="badge badge-ghost badge-sm gap-1 transition hover:border-primary/40 hover:text-primary"
            >
              {name} <span class="text-base-content/70">{count}</span>
            </.link>
          </li>
        </ul>
      </section>

      <section class="rounded-xl border border-base-300/70 bg-base-100 p-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold">Attachments</h2>
          <span class="text-xs tabular-nums text-base-content/70">{@attachment_count}</span>
        </div>
        <.link
          navigate={URLs.space_attachments_path(@space.key)}
          class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline"
        >
          Browse attachments <.icon name="hero-arrow-right" class="size-3.5" />
        </.link>
      </section>

      <section class="rounded-xl border border-base-300/70 bg-base-100 p-4">
        <h2 class="text-sm font-semibold">Export</h2>
        <p class="mt-1 text-xs text-base-content/70">
          The whole space as Markdown with its attachments, as a ZIP.
        </p>
        <a
          href={~p"/spaces/#{@space.key}/export.zip"}
          class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline"
        >
          Download Markdown (.zip) <.icon name="hero-arrow-down-tray" class="size-3.5" />
        </a>
      </section>
    </aside>
  </div>
</Layouts.app>
