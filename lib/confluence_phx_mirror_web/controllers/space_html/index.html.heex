<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_source={@mirror_source}
  page_title={@page_title}
  sidebar?={false}
>
  <header class="border-b border-base-300/70 pb-5">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">Directory</p>
    <h1 class="mt-1 text-3xl font-semibold leading-tight">Spaces</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-base-content/65">
      Every Confluence space mirrored here, with its content counts. Open a space to browse its
      overview, pages, blog posts and attachments.
    </p>
  </header>

  <p :if={@catalog == []} class="mt-8 text-sm text-base-content/50">
    No spaces have been mirrored yet. Run <code>mix confluence.sync</code>.
  </p>

  <div :if={@catalog != []} class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <.space_card
      :for={row <- @catalog}
      space={row.space}
      count={row.pages}
      blog_posts={row.blog_posts}
      updated_at={row.updated_at}
    />
  </div>

  <section class="mt-10">
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-base-content/50">
      Browse elsewhere
    </h2>
    <div class="flex flex-wrap gap-2 text-sm">
      <.link navigate={URLs.labels_path()} class="btn btn-sm btn-ghost gap-2">
        <.icon name="hero-tag" class="size-4" /> Labels
      </.link>
      <.link navigate={URLs.people_path()} class="btn btn-sm btn-ghost gap-2">
        <.icon name="hero-users" class="size-4" /> People
      </.link>
      <.link navigate={URLs.recent_path()} class="btn btn-sm btn-ghost gap-2">
        <.icon name="hero-clock" class="size-4" /> Recently updated
      </.link>
    </div>
  </section>
</Layouts.app>
