<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  spaces={@spaces}
  last_sync_run={@last_sync_run}
  mirror_name={@mirror_name}
  mirror_source={@mirror_source}
  space={@space}
  tree={@tree}
  breadcrumbs={[%{title: @space.name, path: URLs.space_path(@space.key)}]}
  page_title={@page_title}
  rail?={false}
>
  <header class="border-b border-base-300/70 pb-4">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">
          {@space.name}
        </p>
        <h1 class="mt-1 text-2xl font-semibold leading-tight">Blog</h1>
      </div>
      <span class="text-xs tabular-nums text-base-content/50">{length(@posts)} posts</span>
    </div>
  </header>

  <div class="mt-4 border-b border-base-300/70">
    <.space_tabs space={@space} active={@active} />
  </div>

  <.empty_state
    :if={@posts == []}
    icon="hero-newspaper"
    title="No blog posts"
    body="This space has no mirrored blog posts yet."
  />

  <ul :if={@posts != []} class="mt-6 space-y-3">
    <li :for={post <- @posts}>
      <.link
        navigate={URLs.content_path(@space.key, post)}
        class="group block rounded-xl border border-base-300/70 bg-base-100 p-4 transition hover:border-primary/40 hover:shadow-sm"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="text-base font-semibold group-hover:text-primary">{post.title}</span>
          <span class="text-[11px] uppercase tracking-wide text-base-content/40">
            {Time.date(post.external_updated_at)}
          </span>
        </div>
        <span class="mt-1 block line-clamp-2 text-sm leading-relaxed text-base-content/60">
          {String.slice(post.body_text || "", 0, 260)}
        </span>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <span class="text-[11px] text-base-content/45">by {post.author_name}</span>
          <.label_chips labels={post.labels} />
        </div>
      </.link>
    </li>
  </ul>
</Layouts.app>
