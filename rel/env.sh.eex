#!/bin/sh
#
# Release environment, sourced by `bin/confluence_phx_mirror` before the node
# boots. Every RELEASE_* variable has to be set here: the boot script reads them
# once, before the VM starts, so setting them from application code is too late.
#
# One release, three homes, and each names its node differently:
#
#   Fly.io      a Machine is a node on the private network, which is IPv6
#   Kubernetes  a Pod is a node, found through a headless Service (POD_NAME and
#               POD_IP come from the downward API)
#   elsewhere   a single node on the local host, or whatever the operator
#               exported; nothing below overrides an explicit choice
#
# With a node name set, `DNSCluster` — supervised in
# `ConfluencePhxMirror.Application` — joins every peer that DNS_CLUSTER_QUERY
# resolves to. Without one the app is a cluster of one, which is a supported
# deployment: reader rate limits, mirror counters and the traffic tally are per
# node either way, and only PubSub fan-out and Oban's leader election change.

if [ -n "${FLY_APP_NAME:-}" ]; then
  # <app>-<image tag>@<private IPv6>: the image tag rather than the Machine id,
  # because a Machine keeps its id when it moves between regions.
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${FLY_APP_NAME}-${FLY_IMAGE_REF##*-}@${FLY_PRIVATE_IP}"

  # The private network is IPv6-only. Without this flag distribution binds
  # nothing and the node comes up as a loner that still answers HTTP.
  export ERL_AFLAGS="-proto_dist inet6_tcp ${ERL_AFLAGS:-}"

  # Postgres on the same private network is reached over IPv6 too. A database
  # elsewhere (a managed Postgres with no AAAA record) needs ECTO_IPV6=false,
  # or name resolution fails at boot.
  export ECTO_IPV6="${ECTO_IPV6:-true}"

  export DNS_CLUSTER_QUERY="${DNS_CLUSTER_QUERY:-${FLY_APP_NAME}.internal}"

elif [ -n "${POD_IP:-}" ]; then
  # Kubernetes: the downward API supplies POD_NAME (metadata.name) and POD_IP
  # (status.podIP). With a StatefulSet the pod name is stable across restarts,
  # which keeps the node name stable as well.
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${POD_NAME:-$(hostname)}@${POD_IP}"

elif [ -n "${RELEASE_NODE:-}" ]; then
  # Named explicitly (a VM, a bare-metal host, a Compose cluster with fixed node
  # names): use it as given and say so once, because a wrong node name is not
  # visible anywhere else.
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
  echo "release node: ${RELEASE_NODE} (distribution: ${RELEASE_DISTRIBUTION})"

else
  # Local development: one node, short name, epmd on the loopback — the
  # release's own default, spelled out so the branches above read as choices.
  export RELEASE_DISTRIBUTION=sname
fi

# Uncomment to send crash dumps to standard error; useful when a deployment
# collects logs but no files. Off by default: a dump can carry request data.
# export ERL_CRASH_DUMP=/dev/stderr
# export ERL_CRASH_DUMP_BYTES=4096
